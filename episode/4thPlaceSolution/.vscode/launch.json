{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Biohub 4th Place: Main (biohub-4th-place-solution.py)",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "program": "${workspaceFolder}/biohub-4th-place-solution.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false,
      "subProcess": true,
      "env": {
        "PYTHONPATH": "${workspaceFolder};${workspaceFolder}/biohub-4th-place-artifacts",
        "BIOHUB_SKIP_PIP": "1",
        "BIOHUB_KEEP": "1"
      }
    },
    {
      "name": "Python: Current File (4thPlace .venv)",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "program": "${file}",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false,
      "env": {
        "PYTHONPATH": "${workspaceFolder};${workspaceFolder}/biohub-4th-place-artifacts"
      }
    },
    {
      "name": "Biohub 4th Place: Verify Local Env",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "program": "${workspaceFolder}/verify_local_env.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false
    }
  ]
}
